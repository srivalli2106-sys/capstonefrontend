# Frontend environment configuration.
# Anything prefixed with VITE_ is bundled into the client and is PUBLIC.
# Never put secrets, private keys, JWTs, or backend credentials here.

# Backend REST API base URL.
VITE_API_BASE_URL=https://secure-messaging-backend-g7v0.onrender.com

# Backend WebSocket base URL (derived from VITE_API_BASE_URL at runtime if omitted).
# VITE_WS_BASE_URL=wss://secure-messaging-backend-g7v0.onrender.com